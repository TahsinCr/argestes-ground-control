[Unit]
Description=Kirlangic Orin MAVLink Application Agent
After=multi-user.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=kirlangic
SupplementaryGroups=dialout
WorkingDirectory=/home/kirlangic/kirlangic-orin-link
ExecStart=/usr/bin/python3 /home/kirlangic/kirlangic-orin-link/orin_mavlink_agent.py --config /home/kirlangic/kirlangic-orin-link/config.json
Restart=always
RestartSec=5
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
